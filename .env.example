# Токен бота от @BotFather
BOT_TOKEN=

# Ваш личный числовой user_id (НЕ username), куда бот будет слать
# уведомления об удалённых сообщениях. Узнать можно, написав боту /start
# из того же аккаунта, который подключён как Telegram Business, —
# бот сам покажет и запомнит ваш id. Либо впишите заранее, если уже
# знаете его (например, через @userinfobot).
OWNER_ID=

# Путь к SQLite базе
DB_PATH=messages.db

# Путь к файлу, где бот запоминает OWNER_ID после /start (если не задан выше)
STATE_PATH=state.json
